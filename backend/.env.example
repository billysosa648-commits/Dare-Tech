PORT=4000
# Usa 0 en local directo; Render debe confiar en un salto de proxy (1).
TRUST_PROXY_HOPS=0
NODE_ENV=development
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>/<base>?retryWrites=true&w=majority
JWT_SECRET=<secreto-aleatorio-de-al-menos-32-bytes>
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ADMIN_BOOTSTRAP_KEY=<clave-temporal-larga-y-aleatoria-para-el-alta-inicial>
INVOICE_IVA_RATE=15
TURNSTILE_SITE_KEY=<clave-publica-del-widget-turnstile>
TURNSTILE_SECRET=<clave-secreta-de-verificacion-turnstile>
DIAGNOSTIC_RATE_LIMIT_HOURLY=5
DIAGNOSTIC_RATE_LIMIT_DAILY=20
DIAGNOSTIC_CONTACT_DAILY_LIMIT=3
DIAGNOSTIC_MIN_FILL_MS=3000
CHATBOT_RATE_LIMIT_WINDOW_MS=60000
CHATBOT_RATE_LIMIT_MAX=20
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=100
